# این فایل را به .env تغییر نام دهید و مقادیر را پر کنید.
# اگر IMAP_HOST خالی بماند، ایجنت در حالت نمایشی با ایمیل‌های نمونه اجرا می‌شود.

# --- صندوق ایمیل ---
EMAIL_ADDRESS=you@gmail.com
EMAIL_NAME=نام شما
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
# برای Gmail یک «App password» بسازید (myaccount.google.com/apppasswords)؛ رمز اصلی کار نمی‌کند.
IMAP_PASSWORD=

# --- ارسال (اگر خالی باشد از همان تنظیمات IMAP استفاده می‌شود) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- تقویم ---
TIMEZONE=Asia/Tehran
WORK_START=09:00
WORK_END=17:00

# --- مدل ---
AGENT_MODEL=sonnet
# اختیاری: به‌جای ورود Claude Code از کلید API استفاده شود
# ANTHROPIC_API_KEY=
PORT=8010
